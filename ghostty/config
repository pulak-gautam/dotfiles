theme = Aizen Dark

shell-integration-features = ssh-env,ssh-terminfo

keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+k=goto_split:up
keybind = performable:ctrl+l=goto_split:right

keybind = performable:alt+shift+h=resize_split:left,15
keybind = performable:alt+shift+j=resize_split:down,15
keybind = performable:alt+shift+k=resize_split:up,15
keybind = performable:alt+shift+l=resize_split:right,15

keybind = ctrl+shift+r=prompt_tab_title
keybind = ctrl+shift+w=close_surface

font-size = 11
